# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/messpulse
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Ingest ───────────────────────────────────────────────────────────────────
INGEST_KEY=change-me-ingest-key

# ── Mail (use console for local dev; set to resend for staging/prod) ──────────
MAILER_PROVIDER=console
RESEND_API_KEY=
OTP_ALLOWED_DOMAINS=college.edu,accollegehostel.edu

# ── Mess settings defaults ────────────────────────────────────────────────────
DEFAULT_MESS_ID=mess-default
ALLOW_SIMULATOR=true
